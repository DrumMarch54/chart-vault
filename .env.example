# Copy to .env and fill in. The server reads this file at start.
# Shared password for logging in (same idea as your other apps).
WEB_TOKEN=change-me
# Port this app listens on. Must be different from your other apps.
# HOST=127.0.0.1 means only the web server (nginx/caddy) on the VPS can reach it.
PORT=3300
# Where the database, images and thumbnails live (one folder).
DATA_DIR=./data
# Where the daily backup goes.
BACKUP_DIR=./backups
